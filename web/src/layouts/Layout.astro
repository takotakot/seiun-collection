---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/images/icons/seiun_upconv.webp" />
    <link rel="apple-touch-icon" href="/images/icons/seiun_upconv.webp" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kosugi+Maru&family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <title>{title} | 青雲コレクション</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4BX509EG3W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4BX509EG3W');
    </script>
  </head>
  <body class="text-gray-50 flex flex-col min-h-screen font-game">
    <header class="border-b border-indigo-950/50 bg-indigo-950/40 backdrop-blur-md sticky top-0 z-50">
      <div class="w-full max-w-none px-2 sm:px-4 md:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-amber-400 hover:text-amber-300 transition-colors tracking-wider font-game">
          <img src="/images/icons/seiun_upconv.webp" alt="青雲コレクション" class="w-8 h-8 object-contain rounded-md" />
          <span>青雲コレクション</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium">
          <a href="/" class="hover:text-yellow-400 transition-colors">アルバム図鑑</a>
          <a href="/contact" class="hover:text-yellow-400 transition-colors">お問い合わせ</a>
          <a href="/privacy" class="hover:text-yellow-400 transition-colors">プライバシーポリシー</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow w-full max-w-none p-2">
      <slot />
    </main>

    <footer class="border-t border-indigo-950/50 bg-indigo-950/20 mt-auto py-6">
      <div class="w-full max-w-none px-2 sm:px-4 md:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
        <div>
          &copy; 2026 seiun-collection. All rights reserved.
        </div>
        <div class="flex gap-4">
          <a href="/contact" class="hover:text-gray-200 transition-colors">お問い合わせ</a>
          <a href="/privacy" class="hover:text-gray-200 transition-colors">プライバシーポリシー</a>
        </div>
      </div>
    </footer>
  </body>
</html>
