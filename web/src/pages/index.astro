---
import Layout from '../layouts/Layout.astro';
import Album from '../components/Album';
import { getBuildItemsData } from '../lib/server/fetch-items';

const { items, imagePool, buildTimestamp } = await getBuildItemsData();
---

<Layout title="進捗管理・図鑑">
  <div class="space-y-4">
    {/* ヒーローセクション */}
    <div class="relative bg-gradient-to-tr from-gray-950 via-gray-900 to-yellow-950/20 border border-gray-800/80 rounded-3xl p-4 overflow-hidden shadow-2xl">
      <div class="absolute inset-x-0 bottom-0 top-1/2 bg-gradient-to-t from-gray-950/80 to-transparent"></div>
      
      <div class="relative z-10 space-y-3 w-full">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-yellow-500/10 text-yellow-500 text-xs font-bold rounded-full border border-yellow-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse"></span>
          第4世代 イベント対応
        </span>
        <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
          青雲の志 <span class="text-yellow-500 bg-gradient-to-r from-yellow-500 to-amber-300 bg-clip-text text-transparent">コンプリート図鑑</span>
        </h1>
        <p class="text-sm text-gray-400 leading-relaxed font-medium">
          『雀魂-じゃんたま-』内の人気モード「青雲の志」に登場するすべてのお守り、スタンプ、ルーンの取得状況管理および、全ユーザーで共有可能な攻略情報を掲載
        </p>
      </div>
    </div>

    {/* メインのアルバム表示 */}
    <Album initialItems={items} initialImagePool={imagePool} buildTimestamp={buildTimestamp} client:load />
  </div>
</Layout>
